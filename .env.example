# RAILWAY_PROJECT_ID=be201aa5-a718-48ea-bf1a-bdba2104a76d  # set this before deploying to Railway

# ========================== Frontend ==========================
NEXT_PUBLIC_SUPABASE_URL="DONE"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="DONE"
NEXT_PUBLIC_API_BASE_URL="DONE"
NEXT_PUBLIC_APP_URL="DONE"
# NEXT_PUBLIC_SENTRY_DSN — [OPTIONAL-DEV] Sentry DSN for frontend errors; skip during development, errors are logged to console

# ========================== Backend ==========================

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="DONE"
DIRECT_DATABASE_URL="DONE"
SUPABASE_URL="DONE"
SUPABASE_SECRET_KEY="DONE"

REDIS_URL="DONE"
REDIS_TOKEN="DONE"

# ========================== Deployment & AI Service ==========================

# Should be http://localhost:8000 for local dev; set to Modal URL (https://workspace--app.modal.run) before deploying
AI_SERVICE_URL="DONE"
AI_SERVICE_API_KEY="DONE"

# ========================== Market Data ==========================
# [OPTIONAL-DEV] Only needed if yfinance is unavailable; 25 req/day free at alphavantage.co
ALPHA_VANTAGE_API_KEY="DONE"
EODHD_API_KEY=

# ========================== Notifications ==========================
RESEND_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ========================== Error Tracking ==========================
SENTRY_DSN=

# ========================== Server & Environment Settings ==========================
PORT="DONE"
NODE_ENV="DONE"
# development | staging | production — WARNING: do NOT add inline comments on this line, dotenv will include them in the value
ENVIRONMENT="DONE"

# ========================== Rate Limiting ==========================
RATE_LIMIT_MAX="60"
RATE_LIMIT_AUTH_MAX="300"
RATE_LIMIT_AI_MAX="10"

# ========================== LLM Providers ==========================
# Free tier providers for development
GEMINI_API_KEY="DONE"
GEMINI_MODEL="DONE"
XAI_API_KEY="DONE"
# Grok-3-mini is free; grok-4 and above may have costs — verify at console.x.ai before changing
XAI_MODEL="DONE"
HUGGINGFACE_API_KEY="DONE"
HUGGINGFACE_EMBEDDING_MODEL="DONE"

# Paid providers for staging/production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBEDDING_MODEL=
